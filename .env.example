# ---- Supabase (production backend) ----
# The app runs fully on a local data layer when these are NOT set.
# Provide them to switch to real Supabase Auth + Postgres + Storage.
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the client. Used for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Session security (required in production) ----
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Optional: session lifetime in seconds (default: 8 hours; accepted range: 15 minutes–30 days)
SESSION_MAX_AGE_SECONDS=28800

# ---- Email delivery (recommended before inviting real users) ----
# RESEND_API_KEY=
# EMAIL_FROM=MY Academy <no-reply@your-domain.com>

# ---- Billing provider (configure after selecting a gateway) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Optional product config ----
# NEXT_PUBLIC_APP_NAME=MY Academy
# NEXT_PUBLIC_APP_URL=https://your-domain.com
