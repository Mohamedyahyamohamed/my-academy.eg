# ---- Supabase (production backend) ----
# The app runs fully on a local data layer when these are NOT set.
# Provide them to switch to real Supabase Auth + Postgres + Storage.
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the client. Used for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Session security (required in production) ----
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Optional: session lifetime in seconds (default: 8 hours; accepted range: 15 minutes–30 days)
SESSION_MAX_AGE_SECONDS=28800
# Required for the Vercel Cron billing-notification endpoint.
# Generate with: openssl rand -base64 48
CRON_SECRET=
# Set explicitly in Vercel Production; demo authentication is never allowed there.
E2E_DEMO_MODE=false
# Required for signed QR sessions; generate a distinct 32+ character random value.
QR_SESSION_SECRET=

# ---- Email delivery (recommended before inviting real users) ----
# RESEND_API_KEY=
# EMAIL_FROM=MY Academy <no-reply@your-domain.com>

# ---- Billing provider (configure one provider, then set its verified webhook) ----
# Stripe: hosted Checkout. The webhook endpoint is /api/billing/stripe/webhook.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
#
# Paymob Egypt: hosted Unified Checkout. The webhook endpoint is
# /api/billing/paymob/webhook. Keep every value below server-only.
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_PAYMENT_METHODS=123456,card
# PAYMOB_HMAC_SECRET=
# Copy the exact comma-separated transaction callback field order from the
# Paymob dashboard/API Explorer; never guess or change its order.
# PAYMOB_HMAC_FIELD_ORDER=obj.amount_cents,obj.created_at,obj.currency,obj.error_occured,obj.has_parent_transaction,obj.id,obj.integration_id,obj.is_3d_secure,obj.is_auth,obj.is_capture,obj.is_refunded,obj.is_standalone_payment,obj.is_voided,obj.order.id,obj.owner,obj.pending,obj.source_data.pan,obj.source_data.sub_type,obj.source_data.type,obj.success
# Paymob's merchant-specific Unified Checkout redirect format. It must be HTTPS
# and include {client_secret}; add {public_key} only if the dashboard format uses it.
# PAYMOB_CHECKOUT_URL_TEMPLATE=
# PAYMOB_BILLING_PHONE=+201000000000
# PAYMOB_BILLING_CITY=Cairo

# ---- WhatsApp Cloud API (optional; demo-safe unless explicitly live) ----
# رسائل التنبيه الصادرة من الأكاديمية تتطلب opt-in وقالب Meta معتمد.
# الإرسال يبقى معطلاً حتى تضبط WHATSAPP_MODE=live صراحة.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v26.0
# WHATSAPP_MODE=demo
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
#
# ---- Multi-instance rate limiting (recommended for Vercel) ----
# Without these values the app uses a best-effort in-memory limiter per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Optional product config ----
# NEXT_PUBLIC_APP_NAME=MY Academy
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# رابط اختياري لاستقبال طلبات التجربة والمبيعات؛ استخدم صيغة https://wa.me/201XXXXXXXXX
# NEXT_PUBLIC_WHATSAPP_SALES_URL=https://wa.me/201XXXXXXXXX
